{
  "name": "councilos",
  "displayName": "CouncilOS",
  "description": "Multimodel live discussion platform",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        
        "command": "council.start",
        "title": "Start Council"
      }
    ],

    "menus": {
      "editor/context": [
        {
          "command": "council.start",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4"

  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2"
  }
}
